package require tcltest
package require web-user
namespace import ::tcltest::*
::tcltest::testConstraint postgres [info exists ::env(WEB_USER_TEST_PG)]
namespace eval ::authtest {variable password {a long testing password}; variable serial 0}
# Provide the setup test fixture.
proc ::authtest::setup {{mode LOCAL} {policy {}} {mount {}}} {
    variable serial
    variable db
    variable store
    variable router
    variable config
    variable cookie {}
    variable csrf {}
    variable last {}
    variable handles
    set ::env(ENV) $mode
    set db [::tpersist::db_connect -database :memory: -autobegin 0]
    if {$mode eq "PROD"} {
        ::tpersist::db_disconnect $db
        set db [::tpersist::db_connect -dialect postgresql -autobegin 0 {*}$::env(WEB_USER_TEST_PG)]
    }
    ::web::user::initdb $db
    set handles [list [::tink::register_keyset [::tink::aead::create_keyset AES256_GCM]] [::tink::register_keyset [::tink::mac::create_keyset HMAC_SHA256]]]
    set store [::web::user::create -connection $db -config [dict merge [dict create tenant test-[pid]-[incr serial] aead [lindex $handles 0] mac [lindex $handles 1] email_hash_salt test-email-salt] $policy]]
    set router [::tpathexp::router]
    set config [::web::user::mount $router -store $store -config [dict merge {origin https://community.test email_enabled true deliver ::authtest::delivery} $mount]]
    set ::authtest::delivered {}
    set ::authtest::csrf {}
    set ::authtest::cookie {}
}
# Provide the delivery test fixture.
proc ::authtest::delivery {purpose address code} {set ::authtest::delivered [list $purpose $address $code]}
# Provide the cleanup test fixture.
proc ::authtest::cleanup {} {
    $::authtest::router destroy
    ::tpersist::db_disconnect $::authtest::db
    foreach h $::authtest::handles {::tink::unregister_keyset $h}
}
# Provide the call test fixture.
proc ::authtest::call {method path {fields {}} {extraHeaders {}} {addr 127.0.0.1}} {
    variable cookie
    variable csrf
    variable last
    set headers [dict merge [dict create cookie $cookie] $extraHeaders]
    set at [string first ? $path]
    set query {}
    if {$at >= 0} {
        set query [string range $path [expr {$at + 1}] end]
        set path [string range $path 0 [expr {$at - 1}]]
    }
    set req [dict create method $method path $path queryString $query headers $headers]
    if {$method eq "POST"} {
        if {![dict exists $fields csrf]} {dict set fields csrf $csrf}
        set pairs {}
        dict for {k v} $fields {lappend pairs [::tmfa::_uri_component $k]=[::tmfa::_uri_component $v]}
        dict set req body [join $pairs &]
        dict set req headers content-type application/x-www-form-urlencoded
    }
    set last [$::authtest::router dispatch $req [dict create addr $addr]]
    if {[dict exists $last headers Set-Cookie]} {set cookie [lindex [split [dict get $last headers Set-Cookie] {;}] 0]}
    if {[regexp {name="csrf" value="([^"]+)"} [dict get $last body] -> next]} {set csrf $next}
    return [dict get $last statusCode]
}
# Provide the register test fixture.
proc ::authtest::register {} {
    variable password
    call GET /user/register
    if {[call POST /user/register [dict create email Person@example.com password $password]] != 200} {error $::authtest::last}
    set code [lindex $::authtest::delivered 2]
    if {[call POST /user/verify [dict create code $code]] != 200} {error $::authtest::last}
    return $code
}
# Provide the login test fixture.
proc ::authtest::login {} {
    call GET /user/login
    call POST /user/login [dict create email person@example.com password $::authtest::password]
}
# Provide the token test fixture.
proc ::authtest::token {} {::web::user::cookie_token $::authtest::config [dict create headers [dict create Cookie $::authtest::cookie]]}
# Provide the me test fixture.
proc ::authtest::me {} {::web::user::current_user $::authtest::config [dict create headers [dict create cookie $::authtest::cookie]]}
# Provide the setup mfa test fixture.
proc ::authtest::setup_mfa {} {
    call POST /user/two-factor/setup [dict create operation begin password $::authtest::password]
    set row [::web::user::session $::authtest::store [::authtest::token]]
    set secret [::web::user::unseal $::authtest::store [dict get $row pending_secret] [list mfa [dict get $row uid]]]
    set status [call POST /user/two-factor/setup [dict create operation confirm code [::tmfa::get_totp $secret 6 30 SHA1]]]
    if {$status != 200} {error $::authtest::last}
    return $secret
}
test auth-1 {register verifies email, KSUID id, login rotates and logout revokes} -setup {::authtest::setup} -body {
    ::authtest::register
    set old $::authtest::cookie
    set login [::authtest::login]
    set user [::authtest::me]
    set uid [dict get $user id]
    set stored [::web::user::user_by_id $::authtest::store $uid]
    set result [list $login [dict get $user email] [regexp {^user_[A-Za-z0-9]{27}$} $uid] [expr {$old ne $::authtest::cookie}] \
        [expr {[dict get $stored email] ne "person@example.com"}] \
        [string match {$2b$12$*} [::web::user::unseal $::authtest::store [dict get $stored password] [list password-hash $uid]]]]
    set token [::authtest::token]
    lappend result [::authtest::call POST /user/logout] [expr {[::web::user::session $::authtest::store $token] eq {}}]
    set result
} -cleanup {::authtest::cleanup} -result {200 person@example.com 1 1 1 1 200 1}
test auth-2 {CSRF, origin, malformed form, expiry, and reset-only sessions} -setup {::authtest::setup} -body {
    ::authtest::register
    set result [list [::authtest::call POST /user/login {email person@example.com password nope csrf invalid}]]
    lappend result [::authtest::call POST /user/login {email person@example.com password nope} {origin https://evil.test}]
    ::authtest::call POST /user/forgot {email person@example.com}
    lappend result [expr {[::authtest::me] eq {}}] [::authtest::call GET /user]
    set row [::web::user::session $::authtest::store [::authtest::token]]
    ::tsession::sql::update [dict get $::authtest::store -sessions] [dict get $row id] {expires 0}
    lappend result [::authtest::call POST /user/reset [dict create code [lindex $::authtest::delivered 2] password $::authtest::password]]
    set result
} -cleanup {::authtest::cleanup} -result {403 403 1 302 403}
test auth-3 {reset code once only, sessions revoked, password whitespace preserved} -setup {::authtest::setup} -body {
    ::authtest::register
    ::authtest::login
    set oldToken [::authtest::token]
    ::authtest::call POST /user/forgot {email person@example.com}
    set resetToken [::authtest::token]
    set code [lindex $::authtest::delivered 2]
    set new {  a different long password  }
    set result [list [regexp {^[0-9]{6}$} $code] [::authtest::call POST /user/reset [dict create code $code password $new]]]
    lappend result [expr {[::web::user::session $::authtest::store $oldToken] eq {}}] [expr {[::web::user::session $::authtest::store $resetToken] eq {}}]
    lappend result [::authtest::call POST /user/reset [dict create code $code password $new]]
    lappend result [::authtest::call POST /user/login [dict create email person@example.com password [string trim $new]]]
    lappend result [::authtest::call POST /user/login [dict create email person@example.com password $new]]
    set result
} -cleanup {::authtest::cleanup} -result {1 200 1 1 400 401 200}
test auth-4 {2FA enrollment, pending principal, OTP replay and disable} -setup {::authtest::setup} -body {
    ::authtest::register
    ::authtest::login
    set uid [dict get [::authtest::me] id]
    set secret [::authtest::setup_mfa]
    set result [list [dict get [::authtest::me] mfa_enabled]]
    ::authtest::call POST /user/logout
    ::authtest::login
    lappend result [expr {[::authtest::me] eq {}}]
    # The enrollment code cannot be reused to authenticate.
    set used [dict get [::web::user::user_by_id $::authtest::store $uid] last_step]
    lappend result [::authtest::call POST /user/two-factor [dict create code [::tmfa::get_hotp $secret $used 6 SHA1]]]
    # Simulate a subsequent accepted time window without sleeping.
    ::web::user::update $::authtest::store web_user_users [dict create id $uid] {last_step -1}
    lappend result [::authtest::call POST /user/two-factor [dict create code [::tmfa::get_totp $secret 6 30 SHA1]]]
    lappend result [dict get [::authtest::me] mfa_enabled]
    ::web::user::update $::authtest::store web_user_users [dict create id $uid] {last_step -1}
    lappend result [::authtest::call POST /user/two-factor/disable [dict create password $::authtest::password code [::tmfa::get_totp $secret 6 30 SHA1]]]
    lappend result [dict get [::authtest::me] mfa_enabled]
    set result
} -cleanup {::authtest::cleanup} -result {1 1 401 200 1 200 0}

test auth-mfa-retry {reusing the enrollment code redisplays the pending login form and the next code completes it} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 4 totp_window 0}
    ::authtest::register
    ::authtest::login
    set uid [dict get [::authtest::me] id]
    set secret [::authtest::setup_mfa]
    set used [dict get [::web::user::user_by_id $::authtest::store $uid] last_step]
    ::authtest::call POST /user/logout
    set suffix ?return_to=%2Fuser%2Fprofile
    ::authtest::call POST /user/login$suffix [dict create email person@example.com password $::authtest::password]
    set pending [::authtest::token]
    set pendingCsrf $::authtest::csrf
    set ::authtest::now [expr {$used * 30 + 1}]
    rename ::clock ::authtest::real_clock
    # Advance the verifier's clock without sleeping or changing replay state.
    proc ::clock {args} {
        if {$args eq "seconds"} {return $::authtest::now}
        tailcall ::authtest::real_clock {*}$args
    }
} -body {
    set status [::authtest::call POST /user/two-factor$suffix [dict create code [::tmfa::get_hotp $secret $used 6 SHA1]]]
    set html [dict get $::authtest::last body]
    set result [list $status [dict get $::authtest::last headers content-type] \
        [string match {*Wait for the next code*} $html] \
        [string match {*action="/user/two-factor?return_to=%2Fuser%2Fprofile"*} $html] \
        [regexp {name="code"[^>]*value=} $html] \
        [expr {[::authtest::token] eq $pending && $::authtest::csrf eq $pendingCsrf}] \
        [expr {[::authtest::me] eq {}}] \
        [dict get [::web::user::session $::authtest::store $pending] kind] \
        [expr {[dict get [::web::user::user_by_id $::authtest::store $uid] last_step] == $used}]]
    incr ::authtest::now 30
    lappend result [::authtest::call POST /user/two-factor$suffix [dict create code [::tmfa::get_hotp $secret [expr {$used + 1}] 6 SHA1]]] \
        [dict get $::authtest::last headers Location] [expr {[::authtest::me] ne {}}] \
        [::web::user::session $::authtest::store $pending]
    set result
} -cleanup {
    if {[llength [info commands ::authtest::real_clock]]} {
        rename ::clock {}
        rename ::authtest::real_clock ::clock
    }
    ::authtest::cleanup
} -result {401 {text/html; charset=utf-8} 1 1 0 1 1 two-factor 1 302 /user/profile 1 {}}

test auth-mfa-retry-limit {redisplaying or reloading the authenticator form cannot reset its attempt limit} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 4 challenge_limit 2}
    ::authtest::register
    ::authtest::login
    ::authtest::setup_mfa
    ::authtest::call POST /user/logout
    ::authtest::login
} -body {
    set result {}
    foreach attempt {1 2} {
        lappend result [::authtest::call POST /user/two-factor {code invalid}] \
            [string match {*<form method="post" action="/user/two-factor">*} [dict get $::authtest::last body]]
        ::authtest::call GET /user/two-factor
    }
    lappend result [::authtest::call POST /user/two-factor {code invalid}] [expr {[::authtest::me] eq {}}]
    set result
} -cleanup {::authtest::cleanup} -result {401 1 401 1 429 1}

test auth-5 {PROD never exposes codes, cookie is Secure, anonymous reset has same response} -constraints postgres -setup {::authtest::setup PROD} -body {
    ::authtest::register
    ::authtest::call POST /user/forgot {email person@example.com}
    set known [dict get $::authtest::last body]
    regsub -all {name="csrf" value="[^"]+"} $known {CSRF} known
    set cookie [dict get $::authtest::last headers Set-Cookie]
    set code [lindex $::authtest::delivered 2]
    set result [list [expr {[string first $code $known] < 0}] [expr {[string first local-code $known] < 0}] \
        [string match {*; Secure;*} $cookie] [string match {__Host-*} $cookie]]
    ::authtest::call POST /user/forgot {email unknown@example.com}
    set unknown [dict get $::authtest::last body]
    regsub -all {name="csrf" value="[^"]+"} $unknown {CSRF} unknown
    lappend result [expr {$known eq $unknown}]
    set result
} -cleanup {::authtest::cleanup} -result {1 1 1 1 1}
test auth-6 {challenge attempt limits persist despite rejected transactions} -setup {::authtest::setup} -body {
    ::authtest::register
    ::authtest::call POST /user/forgot {email person@example.com}
    set wrong 000000
    if {[lindex $::authtest::delivered 2] eq $wrong} {set wrong 000001}
    set result {}
    for {set i 0} {$i < 6} {incr i} {lappend result [::authtest::call POST /user/reset [dict create code $wrong password $::authtest::password]]}
    set result
} -cleanup {::authtest::cleanup} -result {400 400 400 400 400 429}
test auth-7 {invalid configuration fails before routing, tenant and purpose isolation} -setup {::authtest::setup} -body {
    set store $::authtest::store
    set other $store
    dict set other -tenant other
    set encrypted [::web::user::seal $store text mfa]
    set r [::tpathexp::router]
    set result [list [catch {::web::user::unseal $other $encrypted mfa}] [catch {::web::user::unseal $store $encrypted email}] \
        [catch {::web::user::mount $r -store $store -config {origin https://community.test typo 1}}] [dict get [$r match GET /user] statusCode]]
    $r destroy
    set result
} -cleanup {::authtest::cleanup} -result {1 1 1 404}
test auth-8 {retry pending registration invalidates old code and password; duplicate verified address stays unchanged} -setup {::authtest::setup} -body {
    ::authtest::call GET /user/register
    ::authtest::call POST /user/register [dict create email person@example.com password $::authtest::password]
    set old [lindex $::authtest::delivered 2]
    set oldCookie $::authtest::cookie
    set oldCsrf $::authtest::csrf
    set replacement {replacement pending password}
    ::authtest::call POST /user/register [dict create email person@example.com password $replacement]
    set code [lindex $::authtest::delivered 2]
    set newCookie $::authtest::cookie
    set newCsrf $::authtest::csrf
    # The old challenge is invalid even if two random numeric codes coincide.
    set ::authtest::cookie $oldCookie
    set ::authtest::csrf $oldCsrf
    set result [list [::authtest::call POST /user/verify [dict create code $old]]]
    set ::authtest::cookie $newCookie
    set ::authtest::csrf $newCsrf
    lappend result [::authtest::call POST /user/verify [dict create code $code]]
    lappend result [::authtest::call POST /user/login [dict create email person@example.com password $::authtest::password]]
    lappend result [::authtest::call POST /user/login [dict create email person@example.com password $replacement]]
    ::authtest::call POST /user/register [dict create email person@example.com password $::authtest::password]
    ::authtest::call GET /user/login
    lappend result [::authtest::call POST /user/login [dict create email person@example.com password $replacement]]
    set result
} -cleanup {::authtest::cleanup} -result {403 200 401 200 200}
test auth-9 {reset preserves MFA, QR onboarding and LOCAL codes} -setup {::authtest::setup} -body {
    ::authtest::register
    ::authtest::login
    set secret [::authtest::setup_mfa]
    ::authtest::call POST /user/forgot {email person@example.com}
    set result [list [expr {[string first {id="local-code"} [dict get $::authtest::last body]] >= 0}]]
    ::authtest::call POST /user/reset [dict create code [lindex $::authtest::delivered 2] password $::authtest::password]
    lappend result [::authtest::login] [expr {[::authtest::me] eq {}}]
    lappend result [expr {[string first {id="local-code"} [dict get $::authtest::last body]] >= 0}]
    set result
} -cleanup {::authtest::cleanup} -result {1 200 1 1}
test auth-10 {form parsing rejects duplicates and invalid UTF-8, accepts Lambda bodies} -body {
    set req {headers {content-type application/x-www-form-urlencoded}}
    set result {}
    foreach body {a=1&a=2 a=%FF a=%00 a=%ZZ} {
        dict set req body $body
        lappend result [catch {::web::user::form $req}]
    }
    dict set req body [binary encode base64 {code=abc&password=with+spaces}]
    dict set req isBase64Encoded true
    lappend result [::web::user::form $req]
    set result
} -result {1 1 1 1 {code abc password {with spaces}}}
test auth-11 {bcrypt input boundaries and unmodified Tink API} -setup {::authtest::setup} -body {
    set long [string repeat x 72]
    set hash [::web::user::password_hash $long]
    set store $::authtest::store
    set user [dict create id boundary password [::web::user::seal $store $hash {password-hash boundary}]]
    list [string match {$2b$12$*} $hash] [::web::user::password_ok $store $user $long] \
        [catch {::web::user::password_hash ${long}x}] [::web::user::password_ok $store $user ${long}x] \
        [catch {::web::user::password_hash "long password with \x00 inside"}] \
        [info commands ::tink::password::*] [info commands ::tink::random_bytes] \
        [info commands ::tink::constant_time_equal] [package provide tink]
} -cleanup {::authtest::cleanup} -result {1 1 1 0 1 {} {} {} 20240704.0.3}
test auth-12 {invalid password hash fails closed and can be replaced by email recovery} -setup {::authtest::setup} -body {
    ::authtest::register
    set user [lindex [::web::user::rows $::authtest::store web_user_users] 0]
    ::web::user::update $::authtest::store web_user_users [dict create id [dict get $user id]] {password invalid-record}
    set result [list [::authtest::login]]
    ::authtest::call POST /user/forgot {email person@example.com}
    lappend result [::authtest::call POST /user/reset [dict create code [lindex $::authtest::delivered 2] password $::authtest::password]]
    lappend result [::authtest::login]
    set result
} -cleanup {::authtest::cleanup} -result {401 200 200}

test auth-13 {configured policy drives password, session, QR provisioning, LOCAL code and verification} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 5 password_min_length 18 totp_digits 8 totp_period 60 totp_algorithm SHA256 session_ttl 120} {issuer {Test Garden}}
} -body {
    ::authtest::register
    ::authtest::login
    set store $::authtest::store
    set row [::web::user::session $store [::authtest::token]]
    set user [::web::user::user_by_id $store [dict get $row uid]]
    set result [list [string match {$2b$05$*} [::web::user::unseal $store [dict get $user password] [list password-hash [dict get $user id]]]] \
        [expr {[dict get $row expires] - [clock seconds] > 110}]]
    lappend result [::authtest::call POST /user/two-factor/setup [dict create operation begin password $::authtest::password]]
    set row [::web::user::session $store [::authtest::token]]
    set secret [::web::user::unseal $store [dict get $row pending_secret] [list mfa [dict get $row uid]]]
    set uri [::tmfa::keyuri $secret totp person@example.com -issuer {Test Garden} -digits 8 -step 60 -algorithm SHA256]
    set body [dict get $::authtest::last body]
    set code [::web::user::totp_code $store $secret]
    lappend result [expr {[string first [::tqrcodegen::encode_to_svg $uri] $body] >= 0}] \
        [expr {[string first $code $body] >= 0}] [expr {[string first {pattern="[0-9]{8}"} $body] >= 0}]
    lappend result [::authtest::call POST /user/two-factor/setup [dict create operation confirm code $code]]
    lappend result [dict get [::authtest::me] mfa_enabled]
    lappend result [catch {::web::user::password_hash {only fifteen xx} [dict get $store -config]}]
    set result
} -cleanup {::authtest::cleanup} -result {1 1 200 1 1 1 200 1 1}

test auth-14 {invalid policy/issuer fail before mounting; route methods remain restricted} -setup {::authtest::setup} -body {
    set router [::tpathexp::router]
    set result {}
    foreach policy {{totp_digits 7} {totp_period 0} {totp_algorithm MD5} {bcrypt_cost 17} {password_min_length 2} {challenge_limit 0}} {
        lappend result [catch {::web::user::settings $policy}]
    }
    lappend result [catch {::web::user::mount $router -store $::authtest::store -config {origin https://community.test issuer {bad:issuer}}}]
    lappend result [dict get [$router match GET /user] statusCode]
    lappend result [::authtest::call GET /user/logout] [::authtest::call POST /user]
    $router destroy
    set result
} -cleanup {::authtest::cleanup} -result {1 1 1 1 1 1 1 404 405 405}

test auth-15 {OpenAPI rejects missing, short and undeclared form fields without exposing values} -setup {::authtest::setup} -body {
    ::authtest::call GET /user/register
    set result {}
    foreach fields [list {email person@example.com} {email person@example.com password short} \
        [dict create email person@example.com password $::authtest::password extra submitted-secret-value]] {
        lappend result [::authtest::call POST /user/register $fields]
    }
    lappend result [expr {[string first submitted-secret-value [dict get $::authtest::last body]] < 0}]
    lappend result [llength [::web::user::rows $::authtest::store web_user_users]]
    set result
} -cleanup {::authtest::cleanup} -result {400 400 400 1 0}

test auth-16 {browser forms preserve configured origin without weakening CSRF verification} -setup {
    ::authtest::setup LOCAL {} {origin https://garden.example:8443}
} -body {
    ::authtest::call GET /user/register
    set result [list [dict get $::authtest::last headers referrer-policy]]
    set fields [dict create email person@example.com password $::authtest::password]
    foreach origin {null https://evil.test https://community.test} {
        lappend result [::authtest::call POST /user/register $fields [dict create origin $origin]]
    }
    lappend result [::authtest::call POST /user/register [dict merge $fields {csrf invalid}] {origin https://garden.example:8443}]
    lappend result [::authtest::call POST /user/register $fields {origin https://garden.example:8443}]
    set result
} -cleanup {::authtest::cleanup} -result {same-origin 403 403 403 403 200}

test auth-17 {numeric confirmation codes reject biased values and preserve six digits} -setup {
    rename ::twebserver::random_bytes ::authtest::original_random_bytes
    set ::authtest::randomValues {ffffff f42400 000000 000008 f423ff}
    # Provide the random bytes test fixture.
    proc ::twebserver::random_bytes {length} {
        if {$length != 3 || $::authtest::randomValues eq {}} {error "unexpected random byte request"}
        set value [lindex $::authtest::randomValues 0]
        set ::authtest::randomValues [lrange $::authtest::randomValues 1 end]
        return [binary decode hex $value]
    }
} -body {
    list [::web::user::verification_code] [::web::user::verification_code] \
        [::web::user::verification_code] [llength $::authtest::randomValues]
} -cleanup {
    rename ::twebserver::random_bytes {}
    rename ::authtest::original_random_bytes ::twebserver::random_bytes
    unset ::authtest::randomValues
} -result {000000 000008 999999 0}

test auth-18 {confirmation preserves leading zeros, requires six digits and cannot be replayed} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 5}
    rename ::web::user::verification_code ::authtest::original_verification_code
    # Provide the verification code test fixture.
    proc ::web::user::verification_code {} {return 000008}
} -body {
    ::authtest::call GET /user/register
    set result [list [::authtest::call POST /user/register [dict create email person@example.com password $::authtest::password]]]
    set code [lindex $::authtest::delivered 2]
    set body [dict get $::authtest::last body]
    lappend result $code [expr {[string first {id="local-code">000008</code>} $body] >= 0}] \
        [expr {[string first {inputmode="numeric" pattern="[0-9]{6}"} $body] >= 0}]
    foreach invalid {00008 0000080 00000x} {
        lappend result [::authtest::call POST /user/verify [dict create code $invalid]]
    }
    lappend result [::authtest::call POST /user/verify [dict create code $code]] \
        [::authtest::call POST /user/verify [dict create code $code]]
    set result
} -cleanup {
    rename ::web::user::verification_code {}
    rename ::authtest::original_verification_code ::web::user::verification_code
    ::authtest::cleanup
} -result {200 000008 1 1 400 400 400 200 400}

test auth-19 {numeric confirmation codes expire and enforce the challenge attempt limit} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 5}
} -body {
    ::authtest::call GET /user/register
    ::authtest::call POST /user/register [dict create email person@example.com password $::authtest::password]
    set code [lindex $::authtest::delivered 2]
    set row [::web::user::session $::authtest::store [::authtest::token]]
    ::tsession::sql::update [dict get $::authtest::store -sessions] [dict get $row id] {expires 0}
    set result [list [regexp {^[0-9]{6}$} $code] [::authtest::call POST /user/verify [dict create code $code]]]
    lappend result [expr {[::web::user::user_by_id $::authtest::store [dict get $row uid]] ne {}}]
    ::authtest::call GET /user/register
    ::authtest::call POST /user/register [dict create email person@example.com password $::authtest::password]
    set code [lindex $::authtest::delivered 2]
    set wrong 000000
    if {$code eq $wrong} {set wrong 000001}
    for {set i 0} {$i < 5} {incr i} {
        lappend result [::authtest::call POST /user/verify [dict create code $wrong]]
    }
    lappend result [::authtest::call POST /user/verify [dict create code $code]]
    set result
} -cleanup {::authtest::cleanup} -result {1 403 0 400 400 400 400 400 429}

test auth-20 {password reset preserves leading zeros and requires exactly six numeric digits} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 5}
    ::authtest::register
    rename ::web::user::verification_code ::authtest::original_verification_code
    # Provide the verification code test fixture.
    proc ::web::user::verification_code {} {return 000008}
} -body {
    set result [list [::authtest::call POST /user/forgot {email person@example.com}]]
    set code [lindex $::authtest::delivered 2]
    set body [dict get $::authtest::last body]
    lappend result [lindex $::authtest::delivered 0] $code \
        [expr {[string first {id="local-code">000008</code>} $body] >= 0}] \
        [expr {[string first {inputmode="numeric" pattern="[0-9]{6}"} $body] >= 0}]
    set password {a new reset password}
    foreach invalid {00008 0000080 00000x} {
        lappend result [::authtest::call POST /user/reset [dict create code $invalid password $password]]
    }
    lappend result [::authtest::call POST /user/reset [dict create code $code password $password]] \
        [::authtest::call POST /user/login [dict create email person@example.com password $password]]
    set result
} -cleanup {
    rename ::web::user::verification_code {}
    rename ::authtest::original_verification_code ::web::user::verification_code
    ::authtest::cleanup
} -result {200 reset 000008 1 1 400 400 400 200 200}

# Provide the register named test fixture.
proc ::authtest::register_named {{first {Zoë <b>}} {last O'Neil}} {
    call GET /user/register
    set fields [dict create email person@example.com password $::authtest::password first_name $first last_name $last]
    if {[call POST /user/register $fields] != 200} {error $::authtest::last}
    if {[call POST /user/verify [dict create code [lindex $::authtest::delivered 2]]] != 200} {error $::authtest::last}
}

test auth-21 {name collection defaults off and does not accept hidden profile fields} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 5}
} -body {
    ::authtest::call GET /user/register
    set result [list [expr {[string first {name="first_name"} [dict get $::authtest::last body]] < 0}]]
    lappend result [::authtest::call POST /user/register [dict create email person@example.com password $::authtest::password first_name Mira last_name Fern]]
    ::authtest::register
    ::authtest::login
    lappend result [dict get [::authtest::me] display_name] [::authtest::call GET /user/profile] \
        [llength [::web::user::rows $::authtest::store web_user_profiles]]
    set result
} -cleanup {::authtest::cleanup} -result {1 400 Member 404 0}

test auth-22 {names round-trip encrypted; widgets expose only an escaped first name} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 5 collect_names true}
} -body {
    ::authtest::register_named {  Zoë <b>  }
    ::authtest::login
    set current [::authtest::me]
    set uid [dict get $current id]
    set row [::web::user::one $::authtest::store web_user_profiles [dict create id $uid]]
    set widget [::web::user::widget $::authtest::config profile [dict create user_id $uid] {} {}]
    set result [list [dict get $current first_name] [dict get $current last_name] [dict get $current display_name] \
        [expr {[dict get $row first_name] ne [dict get $current first_name]}] \
        [expr {[dict get $row last_name] ne [dict get $current last_name]}] \
        [expr {[string first {Zoë &lt;b&gt;} $widget] >= 0}] \
        [expr {[string first {O'Neil} $widget] < 0 && [string first person@example.com $widget] < 0}] \
        [catch {::web::user::unseal $::authtest::store [dict get $row first_name] [list profile $uid last_name]}]]
    set other $::authtest::store
    dict set other -tenant another-tenant
    lappend result [dict get [::web::user::public_profile $other $uid] display_name]
    ::web::user::update $::authtest::store web_user_users [dict create id $uid] {active 0}
    lappend result [dict get [::web::user::public_profile $::authtest::store $uid] display_name]
    set result
} -cleanup {::authtest::cleanup} -result {{Zoë <b>} O'Neil {Zoë <b>} 1 1 1 1 1 Member Member}

test auth-23 {enabled names are required, bounded and reject controls while accepting Unicode} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 5 collect_names true}
} -body {
    ::authtest::call GET /user/register
    set result [list [expr {[string first {name="first_name"} [dict get $::authtest::last body]] >= 0}]]
    set fields [dict create email person@example.com password $::authtest::password]
    foreach names [list {} {first_name Mira} {first_name {   } last_name Fern} \
        [dict create first_name "Mi\nra" last_name Fern] [dict create first_name [string repeat x 101] last_name Fern]] {
        lappend result [::authtest::call POST /user/register [dict merge $fields $names]]
    }
    lappend result [::authtest::call POST /user/register [dict merge $fields {first_name 李 last_name 王}]] \
        [catch {::web::user::settings {collect_names maybe}}]
    set result
} -cleanup {::authtest::cleanup} -result {1 400 400 400 400 400 200 1}

