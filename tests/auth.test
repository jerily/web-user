    lappend result [::authtest::call POST /user/profile {first_name Mira last_name Fern csrf wrong}]
    lappend result [::authtest::call POST /user/profile {first_name Mira last_name Fern}]
    lappend result [dict get [::authtest::me] display_name] [dict get [::authtest::me] last_name] \
        [expr {[dict get [::authtest::me] id] eq $uid}]
