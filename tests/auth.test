    ::authtest::setup LOCAL {bcrypt_cost 5}
    ::authtest::register
    ::authtest::login
} -body {
    set secret [::authtest::setup_mfa]
    set result [list $::authtest::delivered]
    set uid [dict get [::authtest::me] id]
    ::web::user::update $::authtest::store web_user_users [dict create id $uid] {last_step -1}
    ::authtest::call POST /user/two-factor/disable [dict create password $::authtest::password code [::web::user::totp_code $::authtest::store $secret]]
    lappend result $::authtest::delivered
    ::authtest::call POST /user/forgot {email person@example.com}
    ::authtest::call POST /user/reset [dict create code [lindex $::authtest::delivered 2] password $::authtest::password]
    lappend result $::authtest::delivered
    set result
} -cleanup {::authtest::cleanup} -result {{mfa-enabled person@example.com {}} {mfa-disabled person@example.com {}} {password-changed person@example.com {}}}

