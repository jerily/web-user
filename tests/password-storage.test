package require tcltest
package require web-user
namespace import ::tcltest::*
if {![llength [info commands ::authtest::setup]]} {
    set savedMatch [::tcltest::configure -match]
    ::tcltest::configure -match __helpers_only__
    source [file join [file dirname [info script]] auth.test]
    ::tcltest::configure -match $savedMatch
}

namespace eval ::passwordtest {}
# Inspect the stored SQL value, not just whether the HTTP login succeeds.
proc ::passwordtest::protected {store row password} {
    set stored [dict get $row password]
    set hash [::web::user::unseal $store $stored [list password-hash [dict get $row id]]]
    expr {$stored ne $password && $stored ne $hash &&
        [string match {$2b$04$*} $hash] && [::bcrypt::checkpw $password $hash] &&
        [::web::user::password_ok $store $row $password]}
}

foreach mode {LOCAL PROD} {
    set constraint [expr {$mode eq "PROD" ? "postgres" : {}}]
    test password-storage-writes-$mode {pending registration, activation, change and recovery store encrypted bcrypt hashes} -constraints $constraint -setup {
        ::authtest::setup $mode {bcrypt_cost 4}
    } -body {
        set store $::authtest::store
        ::authtest::call GET /user/register
        set result [list [::authtest::call POST /user/register [dict create email person@example.com password $::authtest::password]]]
        set pending [lindex [::web::user::rows $store web_user_registrations] 0]
        set uid [dict get $pending id]
        lappend result [::passwordtest::protected $store $pending $::authtest::password] \
            [::authtest::call POST /user/verify [dict create code [lindex $::authtest::delivered 2]]]
        set user [::web::user::user_by_id $store $uid]
        lappend result [::passwordtest::protected $store $user $::authtest::password] \
            [expr {[dict get $user password] eq [dict get $pending password]}] [::authtest::login]
        set changed {a changed test password}
        lappend result [::authtest::call POST /user/change-password [dict create current_password $::authtest::password \
            password $changed confirm_password $changed]]
        set user [::web::user::user_by_id $store $uid]
        lappend result [::passwordtest::protected $store $user $changed]
        ::authtest::call POST /user/forgot {email person@example.com}
        set reset {a recovered test password}
        lappend result [::authtest::call POST /user/reset [dict create code [lindex $::authtest::delivered 2] password $reset]]
        set user [::web::user::user_by_id $store $uid]
        lappend result [::passwordtest::protected $store $user $reset] \
            [::web::user::password_ok $store $user $changed] \
            [::authtest::call POST /user/login [dict create email person@example.com password $reset]]
        set result
    } -cleanup {::authtest::cleanup} -result {200 1 200 1 1 200 200 1 200 1 0 200}
}

test password-storage-binding {ciphertext is randomized and bound to the tenant, account and password purpose} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 4}
} -body {
    set store $::authtest::store
    set hash [::web::user::password_hash $::authtest::password [dict get $store -config]]
    set ciphertext [::web::user::seal $store $hash {password-hash member}]
    set user [dict create id member password $ciphertext]
    set wrongKey [::tink::register_keyset [::tink::aead::create_keyset AES256_GCM]]
    lappend ::authtest::handles $wrongKey
    list [expr {$ciphertext ne [::web::user::seal $store $hash {password-hash member}]}] \
        [::web::user::password_ok $store $user $::authtest::password] \
        [::web::user::password_ok $store $user {a wrong test password}] \
        [::web::user::password_ok $store [dict replace $user id another-member] $::authtest::password] \
        [::web::user::password_ok [dict replace $store -tenant another-tenant] $user $::authtest::password] \
        [::web::user::password_ok [dict replace $store -aead $wrongKey] $user $::authtest::password] \
        [::web::user::password_ok $store [dict replace $user password [::web::user::seal $store $hash {email member}]] $::authtest::password]
} -cleanup {::authtest::cleanup} -result {1 1 0 0 0 0 0}

test password-storage-invalid {tampered ciphertext, bare hashes, plaintext and unsupported decrypted hashes all fail closed} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 4}
} -body {
    set store $::authtest::store
    set hash [::web::user::password_hash $::authtest::password [dict get $store -config]]
    set ciphertext [::web::user::seal $store $hash {password-hash member}]
    set bytes [binary decode base64 $ciphertext]
    binary scan [string index $bytes end] cu last
    set bytes [string replace $bytes end end [binary format cu [expr {$last ^ 1}]]]
    set result {}
    foreach value [list {} malformed $::authtest::password $hash \
        [binary encode base64 -maxlen 0 $bytes] \
        [::web::user::seal $store $::authtest::password {password-hash member}] \
        [::web::user::seal $store [string replace $hash 4 5 31] {password-hash member}]] {
        lappend result [::web::user::password_ok $store [dict create id member password $value] $::authtest::password]
    }
    set result
} -cleanup {::authtest::cleanup} -result {0 0 0 0 0 0 0}

test password-storage-reset-required {an old bare bcrypt hash is refused and email recovery replaces it with ciphertext} -setup {
    ::authtest::setup LOCAL {bcrypt_cost 4}
    ::authtest::register
} -body {
    set store $::authtest::store
    set user [::web::user::user_by_email $store person@example.com]
    set uid [dict get $user id]
    set bare [::web::user::unseal $store [dict get $user password] [list password-hash $uid]]
    ::web::user::update $store web_user_users [dict create id $uid] [dict create password $bare]
    set result [list [::authtest::login]]
    ::authtest::call POST /user/forgot {email person@example.com}
    lappend result [::authtest::call POST /user/reset [dict create code [lindex $::authtest::delivered 2] password $::authtest::password]]
    set user [::web::user::user_by_id $store $uid]
    lappend result [::passwordtest::protected $store $user $::authtest::password] [::authtest::login]
    set result
} -cleanup {::authtest::cleanup} -result {401 200 1 200}

cleanupTests
