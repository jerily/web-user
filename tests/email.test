package require tcltest
package require web-user
package require pure-tcl-aws-ses
package require pure-tcl-aws-sqs
namespace import ::tcltest::*
namespace eval ::mailtest {}
# Provide the setup test fixture.
proc ::mailtest::setup {} {
    variable calls {}
    variable fail 0
    variable config [dict create -prefix /members \
        -store [dict create -config {require_email_delivery true aws_email_enabled true code_ttl 900 email_verification_required true verification_emails_enabled true}] \
        -config {email_enabled true email_from sender@example.com email_region us-east-1 title Garden origin https://garden.test}]
    rename ::aws::ses::create ::mailtest::real_create
    # Provide the create test fixture.
    proc ::aws::ses::create {options} {
        lappend ::mailtest::calls [list create $options]
        return ::mailtest::client
    }
}
# Provide the client test fixture.
proc ::mailtest::client {method args} {
    lappend ::mailtest::calls [list $method {*}$args]
    if {$method eq "send_email" && $::mailtest::fail} {error "injected failure"}
    return test-message-id
}
# Provide the cleanup test fixture.
proc ::mailtest::cleanup {} {
    rename ::aws::ses::create {}
    rename ::mailtest::real_create ::aws::ses::create
}

proc ::mailtest::queue_setup {} {
    setup
    variable fail_method {}
    variable config
    dict set config -config email_queue_enabled true
    dict set config -config email_queue_url https://sqs.us-east-1.amazonaws.com/123456789012/user-emails
    dict set config -config email_queue_callback ::mailtest::queued
    rename ::aws::sqs::create ::mailtest::real_sqs_create
    proc ::aws::sqs::create {options} {
        lappend ::mailtest::calls [list sqs-create $options]
        return ::mailtest::sqs
    }
}
proc ::mailtest::sqs {method args} {
    lappend ::mailtest::calls [list $method {*}$args]
    if {$method eq $::mailtest::fail_method} {error "injected queue failure"}
    if {$method eq "get_queue_url"} {error "unexpected queue URL lookup"}
    return 1
}
proc ::mailtest::queued {url} {
    lappend ::mailtest::calls [list callback $url]
    if {$::mailtest::fail_method eq "callback"} {error "injected callback failure"}
}
proc ::mailtest::queue_cleanup {} {
    rename ::aws::sqs::create {}
    rename ::mailtest::real_sqs_create ::aws::sqs::create
    cleanup
}

test email-1 {SES receives the configured region, sender, recipient and expiring code; client is released} -setup {
    ::mailtest::setup
} -body {
    ::web::user::validate_email_config $::mailtest::config
    ::web::user::deliver $::mailtest::config verify person@example.com 012345
    set message [lindex $::mailtest::calls 1 1]
    list [lindex $::mailtest::calls 0] [dict get $message from] [dict get $message to] \
        [string match {*012345*900 seconds*} [dict get $message text]] \
        [string match {*https://garden.test/members/verify*} [dict get $message text]] [lindex $::mailtest::calls end]
} -cleanup {::mailtest::cleanup} -result {{create {region us-east-1}} sender@example.com person@example.com 1 1 destroy}

test email-2 {disabled delivery and LOCAL never create an SES client} -setup {::mailtest::setup} -body {
    set config $::mailtest::config
    dict set config -config email_enabled false
    dict set config -config email_region {}
    dict set config -config email_from {}
    dict set config -store -config email_verification_required false
    ::web::user::validate_email_config $config
    ::web::user::deliver $config reset person@example.com 012345
    dict set config -config email_enabled true
    dict set config -store -config aws_email_enabled false
    ::web::user::validate_email_config $config
    ::web::user::deliver $config reset person@example.com 012345
    set ::mailtest::calls
} -cleanup {::mailtest::cleanup} -result {}

test email-3 {PROD opt-in requires a valid flag, sender and region} -setup {::mailtest::setup} -body {
    set result {}
    foreach {key value} {email_enabled maybe email_from {} email_region {} email_region {invalid region}} {
        set config $::mailtest::config
        dict set config -config $key $value
        lappend result [catch {::web::user::validate_email_config $config}]
    }
    set result
} -cleanup {::mailtest::cleanup} -result {1 1 1 1}

test email-4 {notification templates contain no code or credential; failures still destroy the client} -setup {::mailtest::setup} -body {
    set result {}
    foreach purpose {password-changed mfa-enabled mfa-disabled} {
        set message [::web::user::email_message $::mailtest::config $purpose person@example.com should-not-appear]
        lappend result [expr {[string first should-not-appear [dict get $message text]] < 0}] \
            [string match {*https://garden.test/members/forgot*} [dict get $message text]]
    }
    set ::mailtest::fail 1
    lappend result [catch {::web::user::deliver $::mailtest::config reset person@example.com 123456}] \
        [lindex $::mailtest::calls end]
    set result
} -cleanup {::mailtest::cleanup} -result {1 1 1 1 1 1 1 destroy}

test email-5 {the enable flag gates direct SES delivery} -setup {::mailtest::setup} -body {
    set config $::mailtest::config
    dict set config -config email_enabled false
    ::web::user::deliver $config reset person@example.com 123456
    set ::mailtest::calls
} -cleanup {::mailtest::cleanup} -result {}

test email-6 {disabling verification messages preserves recovery and security notifications} -setup {::mailtest::setup} -body {
    set config $::mailtest::config
    dict set config -store -config email_verification_required false
    dict set config -store -config verification_emails_enabled false
    ::web::user::validate_email_config $config
    foreach purpose {verify reset password-changed} {::web::user::deliver $config $purpose person@example.com 123456}
    lmap call $::mailtest::calls {lindex $call 0}
} -cleanup {::mailtest::cleanup} -result {create send_email destroy create send_email destroy}
test email-queue-1 {queue receives the SES message and expiry before callback, without calling SES} -setup {
    ::mailtest::queue_setup
} -body {
    ::web::user::validate_email_config $::mailtest::config
    ::web::user::deliver $::mailtest::config reset person@example.com 012345
    set body [::tjson::json_to_simple [lindex $::mailtest::calls 1 2]]
    list [lmap call $::mailtest::calls {lindex $call 0}] \
        [dict get $body version] [dict get $body message to] \
        [string match {*012345*} [dict get $body message text]] \
        [expr {abs([dict get $body expires_at] - [clock seconds] - 900) <= 1}] \
        [lindex $::mailtest::calls end]
} -cleanup {::mailtest::queue_cleanup} \
    -result {{sqs-create send_message destroy callback} 1 person@example.com 1 1 {callback https://sqs.us-east-1.amazonaws.com/123456789012/user-emails}}

test email-queue-2 {enqueue/callback failures destroy client without invoking callback or falling back to SES} -setup {
    ::mailtest::queue_setup
} -body {
    set result {}
    foreach method {send_message callback} {
        set ::mailtest::calls {}
        set ::mailtest::fail_method $method
        lappend result [catch {::web::user::deliver $::mailtest::config reset person@example.com 123456}] \
            [lmap call $::mailtest::calls {lindex $call 0}]
    }
    set result
} -cleanup {::mailtest::queue_cleanup} \
    -result {1 {sqs-create send_message destroy} 1 {sqs-create send_message destroy callback}}

test email-queue-3 {LOCAL, disabled mail, and disabled verification never enqueue} -setup {
    ::mailtest::queue_setup
} -body {
    foreach path {{-store -config aws_email_enabled} {-config email_enabled} {-store -config verification_emails_enabled}} value {false false false} {
        set config $::mailtest::config
        dict set config {*}$path $value
        ::web::user::deliver $config verify person@example.com 123456
    }
    set ::mailtest::calls
} -cleanup {::mailtest::queue_cleanup} -result {}

test email-queue-4 {queue config rejects missing URLs, names, ARNs, insecure URLs and FIFO queues} -setup {
    ::mailtest::queue_setup
} -body {
    set result {}
    foreach {key value} {
        email_queue_enabled maybe
        email_queue_url {}
        email_queue_url user-emails
        email_queue_url arn:aws:sqs:us-east-1:123456789012:user-emails
        email_queue_url http://sqs.us-east-1.amazonaws.com/123456789012/user-emails
        email_queue_url https://sqs.us-east-1.amazonaws.com/123456789012/user-emails.fifo
        email_queue_url https://sqs.us-east-1.amazonaws.com/123456789012/user-emails?query=1
        email_queue_url https://sqs.us-east-1.amazonaws.com/not-an-account/user-emails
    } {
        set config $::mailtest::config
        dict set config -config $key $value
        lappend result [catch {::web::user::validate_email_config $config}]
    }
    dict unset config -config email_queue_url
    lappend result [catch {::web::user::validate_email_config $config}]
} -cleanup {::mailtest::queue_cleanup} -result {1 1 1 1 1 1 1 1 1}

test email-queue-5 {notifications have no code expiry and the callback is optional} -setup {
    ::mailtest::queue_setup
} -body {
    dict unset ::mailtest::config -config email_queue_callback
    ::web::user::deliver $::mailtest::config password-changed person@example.com {}
    set body [::tjson::json_to_simple [lindex $::mailtest::calls 1 2]]
    list [dict get $body expires_at] [lindex $::mailtest::calls end]
} -cleanup {::mailtest::queue_cleanup} -result {0 destroy}

test email-queue-login {one-time sign-in emails expire in the delivery queue and use the verification URL} -setup {
    ::mailtest::queue_setup
} -body {
    set now [clock seconds]
    ::web::user::deliver $::mailtest::config login person@example.com 123456
    set body [::tjson::json_to_simple [lindex $::mailtest::calls 1 2]]
    list [expr {[dict get $body expires_at] >= $now + 900}] \
        [string match {*one-time sign-in code*123456*browser*email-login/verify*} [dict get $body message text]]
} -cleanup ::mailtest::queue_cleanup -result {1 1}
cleanupTests
